#include <winver.h>

1 ICON "nixmount.ico"
1 24 "app.manifest"

// The build passes the package version in, so a file's properties show the release it is.
#define TEXT2(x) #x
#define TEXT(x) TEXT2(x)
#define VERSION TEXT(V_MAJOR) "." TEXT(V_MINOR) "." TEXT(V_PATCH)

VS_VERSION_INFO VERSIONINFO
FILEVERSION V_MAJOR,V_MINOR,V_PATCH,0
PRODUCTVERSION V_MAJOR,V_MINOR,V_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "NixMount"
      VALUE "ProductName", "NixMount"
      VALUE "FileVersion", VERSION
      VALUE "ProductVersion", VERSION
      VALUE "LegalCopyright", "GPL-2.0-only"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
